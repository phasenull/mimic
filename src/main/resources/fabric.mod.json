{
	"schemaVersion": 1,
	"id": "mimic",
	"version": "${version}",
	"name": "Mimic",
	"description": "Join modded servers without installing their mods.",
	"authors": [
		"phasenull"
	],
	"license": "CC0-1.0",
	"icon": "assets/mimic/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.phasenull.mimic.MimicClient"
		],
		"jei_mod_plugin": [
			"dev.phasenull.mimic.compat.MimicJeiPlugin"
		]
	},
	"mixins": [
		{
			"config": "mimic.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mimic.via.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"mimic:commit": "${commit}"
	},
	"suggests": {
		"viafabricplus": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
